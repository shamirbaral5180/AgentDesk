{
  "name": "agentdesk",
  "version": "0.9.0",
  "description": "Portable multi-agent software studio",
  "main": "./out/main/index.js",
  "author": "AgentDesk",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "smoke": "electron-vite build && electron . --smoke",
    "smoke:phase2": "electron-vite build && electron . --phase2-smoke",
    "smoke:phase3": "electron-vite build && electron . --phase3-smoke",
    "smoke:phase4": "electron-vite build && electron . --phase4-smoke",
    "smoke:phase5": "electron-vite build && electron . --phase5-smoke",
    "smoke:phase6": "electron-vite build && electron . --phase6-smoke",
    "smoke:phase7": "electron-vite build && electron . --phase7-smoke",
    "smoke:phase8": "electron-vite build && electron . --phase8-smoke",
    "smoke:phase9": "electron-vite build && electron . --phase9-smoke",
    "screenshot": "electron-vite build && electron . --screenshot=workspace",
    "screenshot:landing": "electron-vite build && electron . --screenshot=landing",
    "screenshot:providers": "electron-vite build && electron . --screenshot=providers",
    "screenshot:team": "electron-vite build && electron . --screenshot=team",
    "screenshot:test": "electron-vite build && electron . --screenshot=test",
    "screenshot:test-run": "electron-vite build && electron . --screenshot=test-run",
    "screenshot:chat": "electron-vite build && electron . --screenshot=chat",
    "screenshot:chat-context": "electron-vite build && electron . --screenshot=chat-context",
    "screenshot:chat-live": "electron-vite build && electron . --screenshot=chat-live",
    "screenshot:build": "electron-vite build && electron . --screenshot=build",
    "screenshot:memory": "electron-vite build && electron . --screenshot=memory",
    "screenshot:meeting": "electron-vite build && electron . --screenshot=meeting",
    "screenshot:build-room": "electron-vite build && electron . --screenshot=build-room",
    "screenshot:mcp": "electron-vite build && electron . --screenshot=mcp",
    "screenshot:data": "electron-vite build && electron . --screenshot=data",
    "screenshot:changes": "electron-vite build && electron . --screenshot=changes",
    "screenshot:approval": "electron-vite build && electron . --screenshot=approval",
    "screenshot:project": "electron-vite build && electron . --screenshot=project",
    "prepare:runtime": "node scripts/prepare-runtime.mjs",
    "dist:dir": "npm run build && npm run prepare:runtime && electron-builder --win dir --x64",
    "dist:win": "npm run build && npm run prepare:runtime && electron-builder --win zip --x64"
  },
  "devDependencies": {
    "@ai-sdk/google": "^4.0.106",
    "@ai-sdk/openai": "^4.0.103",
    "@ai-sdk/openai-compatible": "^3.0.79",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "ai": "^7.0.154",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "com.agentdesk.app",
    "productName": "AgentDesk",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
